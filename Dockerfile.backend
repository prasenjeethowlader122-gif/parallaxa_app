# ============================================================
# Dockerfile.backend — Node.js API Server
# Build:   docker build -f Dockerfile.backend -t parallaxa-backend .
# Run:     docker run -p 3000:3000 --env-file .env parallaxa-backend
# ============================================================

# ── Stage 1: install & build ─────────────────────────────────
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy workspace manifests first (better layer caching)
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/db/package.json                  lib/db/
COPY lib/api-zod/package.json             lib/api-zod/
COPY lib/api-spec/package.json            lib/api-spec/
COPY lib/api-client-react/package.json    lib/api-client-react/
COPY artifacts/api-server/package.json   artifacts/api-server/

# Install ALL workspace deps (needed so workspace: links resolve)
RUN pnpm install --frozen-lockfile

# Copy source
COPY lib/db/             lib/db/
COPY lib/api-zod/        lib/api-zod/
COPY lib/api-spec/       lib/api-spec/
COPY lib/api-client-react/ lib/api-client-react/
COPY artifacts/api-server/ artifacts/api-server/

# Build the API server (esbuild bundles everything into dist/)
RUN pnpm --filter @workspace/api-server run build

# ── Stage 2: lean production image ───────────────────────────
FROM node:20-alpine AS runner

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Only the compiled output is needed; copy external packages separately
COPY --from=builder /app/artifacts/api-server/dist ./dist

# Copy package.json so Node can resolve the few truly external deps
# (firebase-admin, qrcode, otplib — marked external in build.mjs)
COPY --from=builder /app/artifacts/api-server/package.json ./
COPY --from=builder /app/node_modules ./node_modules

RUN mkdir -p /app/uploads

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
