# ============================================================
# Dockerfile.frontend — Next.js Web App
# ============================================================

# ── Stage 1: Build Next.js app ──────────────────────────────
FROM node:22-slim AS builder

# Set working directory
WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@10.30.3

# Copy root workspace files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY lib/ ./lib/
COPY artifacts/social-next-app/ ./artifacts/social-next-app/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Accept build arg for backend URL
ARG API_BASE_URL=https://parallaxa-backend.onrender.com/api/
ENV NEXT_PUBLIC_API_BASE_URL=${API_BASE_URL}

# Build the Next.js app
WORKDIR /app/artifacts/social-next-app
RUN pnpm run build

# ── Stage 2: Serve with Node.js ─────────────────────────────
FROM node:22-slim AS runner

WORKDIR /app

# Don't run as root
RUN groupadd -g 1001 nodejs && useradd -u 1001 -g nodejs nextjs

# Copy built files
COPY --from=builder /app/artifacts/social-next-app/public ./public
COPY --from=builder /app/artifacts/social-next-app/.next/standalone ./
COPY --from=builder /app/artifacts/social-next-app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
