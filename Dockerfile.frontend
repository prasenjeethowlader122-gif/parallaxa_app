# ============================================================
# Dockerfile.frontend — Flutter Web App
# Build:   docker build -f Dockerfile.frontend \
#            --build-arg API_BASE_URL=https://your-backend.onrender.com/api \
#            -t parallaxa-frontend .
# Run:     docker run -p 80:80 parallaxa-frontend
# ============================================================

# ── Stage 1: Build Flutter web ───────────────────────────────
FROM debian:bookworm-slim AS flutter-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl git unzip xz-utils zip libglu1-mesa ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Flutter (stable)
RUN git clone --depth 1 --branch stable https://github.com/flutter/flutter.git /flutter
ENV PATH="/flutter/bin:/flutter/bin/cache/dart-sdk/bin:${PATH}"
ENV TAR_OPTIONS="--no-same-owner"

# Pre-warm Flutter toolchain
RUN flutter precache --web && flutter doctor --android-licenses || true

WORKDIR /app
COPY artifacts/social-flutter-app/ .

# Accept build arg so Render can inject the backend URL at build time
ARG API_BASE_URL=https://parallaxa-backend.onrender.com/api/

RUN flutter pub get
RUN dart run build_runner build --delete-conflicting-outputs || true
RUN flutter build web --release \
      --base-href / \
      --dart-define=API_BASE_URL=${API_BASE_URL}

# ── Stage 2: Serve with Nginx ─────────────────────────────────
FROM nginx:1.27-alpine AS runner

RUN rm -rf /usr/share/nginx/html/*

COPY --from=flutter-builder /app/build/web /usr/share/nginx/html
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
