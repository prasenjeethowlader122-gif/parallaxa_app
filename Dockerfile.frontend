# ============================================================
# Dockerfile.frontend — React/Vite Mockup Sandbox (Frontend)
# Build:   docker build -f Dockerfile.frontend -t parallaxa-frontend .
# Run:     docker run -p 80:80 parallaxa-frontend
# ============================================================

# ── Stage 1: install & build ─────────────────────────────────
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy workspace manifests for caching
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/api-zod/package.json             lib/api-zod/
COPY lib/api-spec/package.json            lib/api-spec/
COPY lib/api-client-react/package.json    lib/api-client-react/
COPY artifacts/mockup-sandbox/package.json artifacts/mockup-sandbox/

# Install deps
RUN pnpm install --frozen-lockfile

# Copy source
COPY lib/api-zod/          lib/api-zod/
COPY lib/api-spec/         lib/api-spec/
COPY lib/api-client-react/ lib/api-client-react/
COPY artifacts/mockup-sandbox/ artifacts/mockup-sandbox/

# Build — Vite emits to artifacts/mockup-sandbox/dist/
RUN PORT=5000 BASE_PATH=/ pnpm --filter @workspace/mockup-sandbox run build

# ── Stage 2: serve with nginx ─────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Remove default nginx page
RUN rm -rf /usr/share/nginx/html/*

# Copy built static assets
COPY --from=builder /app/artifacts/mockup-sandbox/dist /usr/share/nginx/html

# Nginx config: serve SPA, proxy /api/* → backend
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
