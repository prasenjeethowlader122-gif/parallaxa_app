# ─────────────────────────────────────────────────────────────
# Parallaxa — environment variables
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=parallaxa
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=parallaxa

# ── Backend ───────────────────────────────────────────────────
# REQUIRED: generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# OPTIONAL: paste your Firebase service account JSON as a single line (for Google Sign-In)
FIREBASE_SERVICE_ACCOUNT=
