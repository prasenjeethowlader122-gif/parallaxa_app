# ─────────────────────────────────────────────────────────────
# Parallaxa — environment variables  (local docker compose)
# cp .env.example .env  then fill in the values
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=parallaxa
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=parallaxa

# ── Backend (Spring Boot) ─────────────────────────────────────
# REQUIRED — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# OPTIONAL — paste Firebase service account JSON (single line) for Google Sign-In
FIREBASE_SERVICE_ACCOUNT=

# ── Frontend (Flutter bakes this in at build time) ────────────
# Point to wherever your backend is running
API_BASE_URL=http://localhost:8080/api
