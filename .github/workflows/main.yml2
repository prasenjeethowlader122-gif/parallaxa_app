name: Build & Release Android APK

on:
  push:
    tags:
      - "v*.*.*"
  workflow_dispatch:
    inputs:
      profile:
        description: "EAS build profile"
        required: false
        default: "preview"
        type: choice
        options:
          - preview
          - production

jobs:
  build-apk:
    name: Build Android APK
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      # ── Checkout ────────────────────────────────────────────────────────
      - name: Checkout repository
        uses: actions/checkout@v4

      # ── pnpm (must come before node so cache works) ──────────────────────
      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 10

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22

      # ── Install dependencies ─────────────────────────────────────────────
      - name: Install dependencies
        run: pnpm install --no-frozen-lockfile

      # ── EAS CLI ──────────────────────────────────────────────────────────
      - name: Install EAS CLI
        run: npm install -g eas-cli

      # ── Determine build profile ──────────────────────────────────────────
      - name: Set build profile
        id: profile
        run: |
          if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
            echo "value=${{ github.event.inputs.profile }}" >> $GITHUB_OUTPUT
          else
            echo "value=preview" >> $GITHUB_OUTPUT
          fi

      # ── Build APK via EAS ────────────────────────────────────────────────
      - name: Build APK with EAS
        id: eas_build
        working-directory: artifacts/social-app
        env:
          EXPO_TOKEN: jC9iuFuKiE-3eUCiLqU6eR2Q5eXwF5Kq-FCRh68K
        run: |
          echo "Starting EAS build..."
          RESULT=$(eas build \
            --platform android \
            --profile ${{ steps.profile.outputs.value }} \
            --non-interactive \
            --json \
            --no-wait)

          BUILD_ID=$(echo "$RESULT" | jq -r '.[0].id')
          echo "build_id=$BUILD_ID" >> $GITHUB_OUTPUT
          echo "EAS Build ID: $BUILD_ID"

      - name: Wait for EAS build & get APK URL
        id: eas_url
        working-directory: artifacts/social-app
        env:
          EXPO_TOKEN: jC9iuFuKiE-3eUCiLqU6eR2Q5eXwF5Kq-FCRh68K
        run: |
          BUILD_ID="${{ steps.eas_build.outputs.build_id }}"
          echo "Waiting for build $BUILD_ID to complete..."

          for i in $(seq 1 60); do
            RESULT=$(eas build:view "$BUILD_ID" --json)
            STATUS=$(echo "$RESULT" | jq -r '.status')
            echo "  Status: $STATUS (attempt $i/60)"

            if [ "$STATUS" = "FINISHED" ]; then
              APK_URL=$(echo "$RESULT" | jq -r '.artifacts.buildUrl')
              echo "apk_url=$APK_URL" >> $GITHUB_OUTPUT
              echo "APK URL: $APK_URL"
              break
            fi

            if [ "$STATUS" = "ERRORED" ] || [ "$STATUS" = "CANCELLED" ]; then
              echo "Build failed with status: $STATUS"
              exit 1
            fi

            sleep 60
          done

          if [ -z "$(grep 'apk_url' $GITHUB_OUTPUT)" ]; then
            echo "Build timed out after 60 minutes"
            exit 1
          fi

      # ── Download APK ─────────────────────────────────────────────────────
      - name: Download APK
        run: |
          mkdir -p dist
          curl -L "${{ steps.eas_url.outputs.apk_url }}" -o dist/social-app.apk
          echo "APK size: $(du -sh dist/social-app.apk | cut -f1)"

      # ── Derive release tag ────────────────────────────────────────────────
      - name: Set release tag
        id: tag
        run: |
          if [ "${{ github.event_name }}" = "push" ]; then
            echo "value=${{ github.ref_name }}" >> $GITHUB_OUTPUT
          else
            echo "value=manual-$(date +'%Y%m%d-%H%M%S')" >> $GITHUB_OUTPUT
          fi

      # ── Create GitHub Release & upload APK ───────────────────────────────
      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ steps.tag.outputs.value }}
          name: "SocialApp Release ${{ steps.tag.outputs.value }}"
          body: |
            # 🚀 SocialApp Android Release — `${{ steps.tag.outputs.value }}`

            Welcome to the latest version of Parallaxa Social! This release was automatically generated via GitHub Actions using Expo Application Services (EAS).

            ## 🛠 Build Information
            - **EAS Profile:** `${{ steps.profile.outputs.value }}`
            - **Commit SHA:** `${{ github.sha }}`
            - **Workflow Run:** [View on GitHub](${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }})

            ## 📦 Installation Instructions
            1. **Download:** Click on `social-app.apk` in the Assets section below.
            2. **Permit:** If prompted, allow your browser to download files from unknown sources.
            3. **Install:** Open the `.apk` file and select **Install**. You may need to enable "Install unknown apps" for your file manager or browser in Android Settings.
            4. **Enjoy:** Launch the app and start exploring!

            ---
            *Automated release managed by Parallaxa Engineering.*
          files: dist/social-app.apk
          draft: false
          prerelease: ${{ steps.profile.outputs.value != 'production' }}
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
